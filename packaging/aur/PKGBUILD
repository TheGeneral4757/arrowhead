# Maintainer: James Thiessen <https://github.com/TheGeneral4757>
# arrowhead is written with AI (Claude Code, Claude Opus 5.5), directed and tested by its maintainer.
# Automating input in Roblox breaks its Terms of Use: private servers only, at your own risk.
pkgname=arrowhead-bin
pkgver=0.2.0
pkgrel=1
pkgdesc="Screen-reading Funky Friday (Roblox) autoplayer for private servers"
arch=('x86_64')
url="https://github.com/TheGeneral4757/arrowhead"
license=('MIT')
depends=('webkit2gtk-4.1' 'libsoup3' 'gtk3' 'pipewire' 'xdg-desktop-portal')
optdepends=('xdg-desktop-portal-kde: screen capture and hotkeys on KDE Plasma'
            'xdg-desktop-portal-hyprland: screen capture and hotkeys on Hyprland')
provides=('arrowhead')
conflicts=('arrowhead')
source=("$url/releases/download/v$pkgver/arrowhead-$pkgver-linux-x86_64.tar.gz")
sha256sums=('0c92387d7659086943034eb5f48d5284371d956ada464a41852b10899d4285c5')

package() {
  cd "arrowhead-$pkgver-linux-x86_64"
  install -Dm755 arrowhead "$pkgdir/usr/bin/arrowhead"
  install -Dm755 arrowhead-cli "$pkgdir/usr/bin/arrowhead-cli"
  install -Dm755 arrowhead-overlay "$pkgdir/usr/lib/arrowhead/arrowhead-overlay"
  # The app reads this and leaves updates to the package manager (spec 10).
  echo aur | install -Dm644 /dev/stdin "$pkgdir/usr/lib/arrowhead/packaged"
  install -Dm644 arrowhead.desktop "$pkgdir/usr/share/applications/arrowhead.desktop"
  for s in 32 128 256 512; do
    install -Dm644 "icons/${s}.png" "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/arrowhead.png"
  done
  install -Dm644 models/text-detection.onnx "$pkgdir/usr/share/arrowhead/models/text-detection.onnx"
  install -Dm644 models/text-recognition.onnx "$pkgdir/usr/share/arrowhead/models/text-recognition.onnx"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD_PARTY_NOTICES.md "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.md"
}
