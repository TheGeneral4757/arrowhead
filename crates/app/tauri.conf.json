{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "arrowhead",
  "version": "0.2.0",
  "identifier": "dev.arrowhead.app",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "arrowhead",
        "width": 1100,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY3M0UxMzcyMDNBQUVDOTgKUldTWTdLb0RjaE0rOTE4VGRnVmdRU3hCK3llMDluZUZ4WnY2eFVuVGlBYm9BY2FJUnI2bzlMSysK",
      "endpoints": [
        "https://github.com/TheGeneral4757/arrowhead/releases/latest/download/latest.json"
      ]
    }
  }
}
